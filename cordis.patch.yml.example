# Optional overrides for ~/.dsh/profiles/web/cordis.patch.yml.
# The bundle patch already inserts the `llm-claude-compat` row; override it by id
# instead of inserting a second copy.

# 1) Restrict interception to one gateway:
- id: llm-claude-compat
  config:
    includeProviders: [gateway]

# 2) Assume a stricter client shape for a gateway that inspects tool schemas:
# - id: llm-claude-compat
#   config:
#     claudeCodeCompat:
#       toolSchema: claude-code

# 3) Turn the whole thing off:
# - id: llm-claude-compat
#   config:
#     enabled: false
